LISTEN_ADDRESS=0.0.0.0:8080
BACKUP_DIRECTORY=/backups
CONSOLES=HOME
CONSOLE_HOME_URL=https://192.168.1.1:443
CONSOLE_HOME_USERNAME_FILE=/run/secrets/home_username
CONSOLE_HOME_PASSWORD_FILE=/run/secrets/home_password
CONSOLE_HOME_TARGETS=network,protect
CONSOLE_HOME_BACKUP_INTERVAL=24h
CONSOLE_HOME_HEALTH_MAX_AGE=48h
CONSOLE_HOME_HTTP_TIMEOUT=30m
CONSOLE_HOME_SKIP_TLS_VERIFY=false
CONSOLE_HOME_RETENTION_DAILY=14
CONSOLE_HOME_RETENTION_WEEKLY=12
CONSOLE_HOME_WEEKLY_INTERVAL=168h
